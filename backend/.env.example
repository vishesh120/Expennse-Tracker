# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# MongoDB configuration
# Defaults to localhost:27017, but automatically uses resilient in-memory mock store if server is unreachable
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=ai_expense_tracker
USE_MOCK_DB=auto

# Security & JWT configuration
# IMPORTANT: Generate secure random keys for production
JWT_SECRET_KEY=dev_secret_jwt_key_at_least_32_chars_expense_tracker_secure_2026
JWT_REFRESH_SECRET_KEY=dev_secret_refresh_key_at_least_32_chars_expense_tracker_2026
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Optional AI API Key (Gemini / OpenAI) for advanced LLM financial insights.
# App provides rich statistical & machine learning insights even without any external key!
GEMINI_API_KEY=
